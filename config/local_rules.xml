<!-- User rules 100000-120000. All JSON scenarios are explicitly synthetic. -->
<group name="homelab,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^homelab$</field>
    <description>Home lab synthetic telemetry.</description>
  </rule>
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="event_type">^auth_failure$</field>
    <description>LAB: Failed login for $(lab_user) from $(lab_source_ip).</description>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100102" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>correlation_key</same_field>
    <description>LAB: Repeated failed logins from $(lab_source_ip) in one test run.</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,</group>
  </rule>
  <rule id="100103" level="7">
    <if_sid>100100</if_sid>
    <field name="event_type">^auth_success$</field>
    <field name="lab_user">^root$</field>
    <description>LAB: Successful privileged login from $(lab_source_ip).</description>
    <mitre><id>T1078</id></mitre>
    <group>authentication_success,</group>
  </rule>
  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="event_type">^process_start$</field>
    <field name="lab_command" type="pcre2">(?i)powershell.*-encodedcommand\s</field>
    <description>LAB: Encoded PowerShell command observed in a synthetic event.</description>
    <mitre><id>T1059.001</id></mitre>
    <group>execution,</group>
  </rule>
  <rule id="100105" level="8">
    <if_sid>100100</if_sid>
    <field name="event_type">^web_request$</field>
    <field name="lab_url" type="pcre2">\.\./</field>
    <description>LAB: Directory traversal pattern in a synthetic web request.</description>
    <group>web,</group>
  </rule>
</group>
